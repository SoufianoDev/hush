{
  "name": "hush-agent-plugin",
  "version": "1.0.0",
  "private": false,
  "description": "Cross-agent Hush skill and native integrations for Claude Code, Codex, Cursor, Cline, Roo, Junie, Windsurf, Gemini CLI, Copilot, OpenCode, Antigravity, and MiMo Code.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "src/",
    "skills/",
    ".agents/",
    ".opencode/",
    ".cline/",
    ".roo/",
    ".junie/",
    ".windsurf/",
    ".mimocode/",
    "plugin.json",
    ".claude-plugin/",
    ".codex-plugin/",
    ".antigravity-plugin/",
    "GEMINI.md",
    "README.md",
    "docs/",
    "scripts/",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "bundle": "node scripts/build.mjs",
    "sync:skills": "node scripts/sync-skills.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
